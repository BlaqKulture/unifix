# Copy to .env for local development (never commit the real .env)

# Leave unset to use a local SQLite file, or point at PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=8

# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173

# Create tables and load demo data automatically on start-up
AUTO_SEED=true
